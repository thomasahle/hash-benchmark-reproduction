+/* ChainHash-x86 scratch registration; canonical LE byte hash, swapped output. */
+#include "Platform.h"
+#include "Hashlib.h"
+#include "chainhash_x86.h"
+
+static thread_local chainhash_x86_key chx_seed_key;
+static seed_t chx_seed(seed_t seed) {
+    chx_seed_key=chainhash_x86_key_from_seed((uint64_t)seed);
+    return (seed_t)(uintptr_t)&chx_seed_key;
+}
+template<bool bswap>
+static void chx_hash(const void *in,const size_t len,const seed_t seed,void *out) {
+    const chainhash_x86_key *key=(const chainhash_x86_key*)(uintptr_t)seed;
+    PUT_U64<bswap>(chainhash_x86(key,in,len),(uint8_t*)out,0);
+}
+REGISTER_FAMILY(chainhash_x86,
+    $.src_status=HashFamilyInfo::SRC_ACTIVE
+);
+REGISTER_HASH(chainhash_x86,
+    $.desc="ChainHash-x86, adjacent PH pairs, 1 KB blocks, three-key GF(2^64) chain, twisted quintic",
+    $.impl="C99 runtime AVX512F+VPCLMUL / AVX2+PCLMUL / portable",
+    $.hash_flags=FLAG_HASH_CLMUL_BASED,
+    $.impl_flags=FLAG_IMPL_LICENSE_MIT,
+    $.bits=64,
+    $.verification_LE=0x363953CA,
+    $.verification_BE=0x61C632F7,
+    $.seedfn=chx_seed,
+    $.hashfn_native=chx_hash<false>,
+    $.hashfn_bswap=chx_hash<true>
+);
diff --git a/hashes/chainhash_x86.h b/hashes/chainhash_x86.h
