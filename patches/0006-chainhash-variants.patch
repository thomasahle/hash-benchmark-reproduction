diff --git a/hashes/chainhash_smhasher3_adjacent_common.h b/hashes/chainhash_smhasher3_adjacent_common.h
new file mode 100644
index 00000000..d65cd63b
--- /dev/null
+++ b/hashes/chainhash_smhasher3_adjacent_common.h
@@ -0,0 +1,24 @@
+// Canonical little-endian API in both SMHasher endian modes.
+#include "Platform.h"
+#include "Hashlib.h"
+#include "chainhash_arm.h"
+static uintptr_t adjacent_seed(seed_t seed) {
+    static thread_local chainhash_arm_key key;
+    key=chainhash_arm_key_from_seed(seed);
+    return reinterpret_cast<uintptr_t>(&key);
+}
+template <int Batch> static void Adjacent(const void *p,size_t len,seed_t seed,void *out) {
+    const auto *key=reinterpret_cast<const chainhash_arm_key *>(uintptr_t(seed));
+    uint64_t h;
+#if CHAINHASH_ARM_BLOCK_BYTES == 256
+    if (Batch==8) h=chainhash_arm_batch8(key,p,len);
+    else if (Batch==4) h=chainhash_arm_batch4(key,p,len);
+    else if (Batch==2) h=chainhash_arm_batch2(key,p,len);
+    else
+#endif
+    h=chainhash_arm_batch1(key,p,len);
+    for (unsigned i=0;i<8;++i) static_cast<uint8_t *>(out)[i]=uint8_t(h>>(8*i));
+}
+#if !CHAINHASH_ARM_HAVE_NEON
+#error The M2 benchmark must use the PMULL backend
+#endif
