+/* Faithful C port of .NET's System.Marvin (dotnet/runtime main,
+ * src/libraries/System.Private.CoreLib/src/System/Marvin.cs, last change
+ * commit 2dada4c5 2025-08-18; verified against main @ aec1470a 2026-09-18).
+ *
+ * Little-endian path only (x86-64 and arm64 are both little-endian; the C#
+ * code is pure scalar and identical on both ISAs).
+ *
+ * string.GetHashCode() == (int)marvin32(utf16le_bytes, 2*len, DefaultSeed)
+ * where DefaultSeed is a 64-bit value read once per process from the OS CSPRNG.
+ */
+#ifndef MARVIN_PORT_H
+#define MARVIN_PORT_H
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+
+static inline uint32_t marvin_rotl32(uint32_t v, int s) { return (v << s) | (v >> (32 - s)); }
+static inline uint32_t marvin_ld32(const uint8_t *p) { uint32_t v; memcpy(&v, p, 4); return v; } /* LE host */
+static inline uint32_t marvin_ld16(const uint8_t *p) { uint16_t v; memcpy(&v, p, 2); return v; }
+
+/* Block(ref p0, ref p1) verbatim. */
+static inline void marvin_block(uint32_t *rp0, uint32_t *rp1) {
+    uint32_t p0 = *rp0, p1 = *rp1;
+    p1 ^= p0; p0 = marvin_rotl32(p0, 20);
+    p0 += p1; p1 = marvin_rotl32(p1, 9);
+    p1 ^= p0; p0 = marvin_rotl32(p0, 27);
+    p0 += p1; p1 = marvin_rotl32(p1, 19);
+    *rp0 = p0; *rp1 = p1;
+}
+
+/* ComputeHash32(ref byte data, uint count, uint p0, uint p1), returning the
+ * final (p0,p1) state so that both the 32-bit collapse (p1^p0, current .NET)
+ * and the legacy 64-bit output (p1<<32|p0, corefx Marvin.ComputeHash) can be
+ * formed.  Control flow mirrors the C# gotos exactly. */
+static inline void marvin_state(const uint8_t *data, uint32_t count, uint32_t p0, uint32_t p1,
+                                uint32_t *out_p0, uint32_t *out_p1) {
+    uint32_t partialResult;
+    if (count < 8) {
+        if (count >= 4) goto Between4And7BytesRemain;
+        goto InputTooSmallToEnterMainLoop;
+    }
+    {
+        uint32_t loopCount = count / 8;
+        do {
+            p0 += marvin_ld32(data);
+            uint32_t nextUInt32 = marvin_ld32(data + 4);
+            marvin_block(&p0, &p1);
+            p0 += nextUInt32;
+            marvin_block(&p0, &p1);
+            data += 8;
+        } while (--loopCount > 0);
+    }
+    if ((count & 4u) == 0) goto DoFinalPartialRead;
+
+Between4And7BytesRemain:
+    p0 += marvin_ld32(data);
+    marvin_block(&p0, &p1);
+
+DoFinalPartialRead:
+    /* read the last 4 bytes of the buffer (overlapping already-consumed bytes) */
+    partialResult = marvin_ld32(data + (count & 7) - 4);
+    count = ~count << 3;
+    partialResult >>= 8;
+    partialResult |= 0x80000000u;
+    partialResult >>= (int)(count & 0x1F);
+    goto DoFinalRoundsAndReturn;
+
+InputTooSmallToEnterMainLoop:
+    partialResult = 0x80u;
+    if (count & 1u) {
+        partialResult = data[count & 2];
+        partialResult |= 0x8000u;
+    }
+    if (count & 2u) {
+        partialResult <<= 16;
+        partialResult |= marvin_ld16(data);
+    }
+
+DoFinalRoundsAndReturn:
+    p0 += partialResult;
+    marvin_block(&p0, &p1);
+    marvin_block(&p0, &p1);
+    *out_p0 = p0; *out_p1 = p1;
+}
+
+/* Current .NET: Marvin.ComputeHash32(ReadOnlySpan<byte>, ulong seed) -> int */
+static inline uint32_t marvin32(const uint8_t *data, size_t count, uint64_t seed) {
+    uint32_t p0, p1;
+    marvin_state(data, (uint32_t)count, (uint32_t)seed, (uint32_t)(seed >> 32), &p0, &p1);
+    return p1 ^ p0;
+}
+
+/* Legacy corefx Marvin.ComputeHash(ReadOnlySpan<byte>, ulong) -> long (64-bit) */
+static inline uint64_t marvin64_legacy(const uint8_t *data, size_t count, uint64_t seed) {
+    uint32_t p0, p1;
+    marvin_state(data, (uint32_t)count, (uint32_t)seed, (uint32_t)(seed >> 32), &p0, &p1);
+    return ((uint64_t)p1 << 32) | p0;
+}
+
+/* string.GetHashCode() for a UTF-16 code-unit array of n chars */
+static inline int32_t marvin_string_hash(const uint16_t *chars, size_t nchars, uint64_t seed) {
+    return (int32_t)marvin32((const uint8_t *)chars, 2 * nchars, seed);
+}
+#endif
