+template <bool bswap>
+static FORCE_INLINE chainhash_v128 chainhash_v_loadwords( const uint8_t * p ) {
+    chainhash_v128 v = { GET_U64<bswap>(p, 0), GET_U64<bswap>(p, 8) };
