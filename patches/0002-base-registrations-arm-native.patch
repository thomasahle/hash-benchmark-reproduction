+
+#if !defined(__x86_64__) || !UMASH_INLINE_ASM
+static inline void
+mul128(uint64_t x, uint64_t y, uint64_t *hi, uint64_t *lo)
+{
+	__uint128_t product = x;
+
+	product *= y;
+	*hi = product >> 64;
+	*lo = product;
+	return;
+}
+#else
+static inline void
+mul128(uint64_t x, uint64_t y, uint64_t *hi, uint64_t *lo)
+{
+	uint64_t mulhi, mullo;
+
+	__asm__("mul %3" : "=a"(mullo), "=d"(mulhi) : "%a"(x), "r"(y) : "cc");
+	*hi = mulhi;
+	*lo = mullo;
+	return;
+}
+#endif
