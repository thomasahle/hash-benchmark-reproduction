+// 64x64 -> 128 carry-less product, bit by bit.
+static FORCE_INLINE chainhash_v128 chainhash_clmul_serial( uint64_t a, uint64_t b ) {
+    chainhash_v128 r = { 0, 0 };
+
+    for (int i = 0; i < 64; i++) {
+        const uint64_t m = UINT64_C(0) - ((b >> i) & 1);
+        r.lo ^= (a << i) & m;
+        if (i > 0) { r.hi ^= (a >> (64 - i)) & m; }
+    }
+    return r;
