+TEST_DEF HOT struct umash_fp
+umash_fprint_multiple_blocks_generic(struct umash_fp initial,
+    const uint64_t multipliers[static 2][2], const uint64_t *oh, uint64_t seed,
+    const void *data, size_t n_blocks)
