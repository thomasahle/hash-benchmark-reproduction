+++ b/hashes/vendor/umash/umash_long.inc
@@ -0,0 +1,1061 @@
+/* -*- mode: c; -*- vim: set ft=c: */
+
+/*
+ * UMASH is distributed under the MIT license.
+ *
+ * SPDX-License-Identifier: MIT
+ *
+ * Copyright 2020-2022 Backtrace I/O, Inc.
+ * Copyright 2022 Paul Khuong
