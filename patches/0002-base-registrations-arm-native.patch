+
+static FORCE_INLINE chainhash_v128 chainhash_v_xor3( chainhash_v128 a, chainhash_v128 b, chainhash_v128 c ) {
+    chainhash_v128 v = { a.lo ^ b.lo ^ c.lo, a.hi ^ b.hi ^ c.hi };
