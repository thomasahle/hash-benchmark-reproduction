+static FORCE_INLINE chainhash_gf chainhash_recur( chainhash_gf P, chainhash_v128 acc, chainhash_gf Yhi, chainhash_gf U ) {
+    return acc.lo ^ chainhash_gfmul(acc.hi ^ Yhi, P ^ U);
