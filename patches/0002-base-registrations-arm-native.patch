+/* SMHasher3 swapped-endian one-shot adapter; native code is unaffected. */
+#ifdef SMHASHER_BSWAP
+static inline void smh_swap_lanes(void *p, size_t n) {
+    for (size_t i = 0; i < n; i += 8) {
+        uint64_t x;
+        memcpy(&x, (char *)p + i, 8);
+        x = __builtin_bswap64(x);
+        memcpy((char *)p + i, &x, 8);
+    }
