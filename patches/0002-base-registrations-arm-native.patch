+3. This notice may not be removed or altered from any source distribution.
+*/
+/* foldhash 0.2.0, altered C++ port of Orson Peters' Rust implementation.
+ * Original copyright (c) 2024 Orson Peters. SPDX-License-Identifier: Zlib
+ * See foldhash-upstream/LICENSE. Native 64-bit algorithm; raw write(bytes), finish().
+ * SMHasher seed S => per_hasher_seed=S, SharedSeed::from_u64(S).
+ * SharedSeed expansion is in seedfn, outside the timed hash call (as rust-ahash).
+ */
+#ifdef FOLDHASH_STANDALONE
+#include <cstdint>
+#include <cstddef>
+#include <cstring>
+#include <iostream>
+#include <iomanip>
+#include <vector>
+#include <string>
+using seed_t = uint64_t;
+template<bool swap> static uint64_t GET_U64(const uint8_t *p, size_t o) {uint64_t x; memcpy(&x,p+o,8); return swap?__builtin_bswap64(x):x;}
+template<bool swap> static uint32_t GET_U32(const uint8_t *p, size_t o) {uint32_t x; memcpy(&x,p+o,4); return swap?__builtin_bswap32(x):x;}
+template<bool swap> static void PUT_U64(uint64_t x,uint8_t *p,size_t o) {if(swap)x=__builtin_bswap64(x);memcpy(p+o,&x,8);}
+#else
+#include "Platform.h"
+#include "Hashlib.h"
+#include "Mathmult.h"
+#endif
+namespace {
+static inline uint64_t fold(uint64_t x,uint64_t y) {
+#ifdef FOLDHASH_STANDALONE
+    __uint128_t p=(__uint128_t)x*y; return uint64_t(p)^uint64_t(p>>64);
+#else
+    uint64_t lo,hi; MathMult::mult64_128(lo,hi,x,y); return lo^hi;
+#endif
+}
+struct FoldSeed {uint64_t per, s[6];};
+static FoldSeed expand(uint64_t per,uint64_t x) {
+    FoldSeed r; r.per=per;
+    for(unsigned i=0;i<6;++i) {for(unsigned j=0;j<3;++j)x=fold(x,UINT64_C(0xbe5466cf34e90c6c));r.s[i]=x|UINT64_C(0x8000000080000001);}
+    return r;
+}
+static thread_local FoldSeed state;
+static uintptr_t init_state(seed_t seed) {state=expand(seed,seed);return (uintptr_t)&state;}
+static inline uint64_t ror(uint64_t x,size_t n) {unsigned r=n&63;return (x>>r)|(x<<((-r)&63));}
+template<bool bswap> static uint64_t hash_long(const uint8_t *v,size_t len,uint64_t a,const uint64_t *s) {
+    uint64_t s0=a,s1=a+s[1];
+    if(len>128) {
+        uint64_t s2=a+s[2],s3=a+s[3];
+        if(len>256) {
+            uint64_t s4=a+s[4],s5=a+s[5];
+            do {
+                s0=fold(GET_U64<bswap>(v,0)^s0,GET_U64<bswap>(v,48)^s[0]);
+                s1=fold(GET_U64<bswap>(v,8)^s1,GET_U64<bswap>(v,56)^s[0]);
+                s2=fold(GET_U64<bswap>(v,16)^s2,GET_U64<bswap>(v,64)^s[0]);
+                s3=fold(GET_U64<bswap>(v,24)^s3,GET_U64<bswap>(v,72)^s[0]);
+                s4=fold(GET_U64<bswap>(v,32)^s4,GET_U64<bswap>(v,80)^s[0]);
+                s5=fold(GET_U64<bswap>(v,40)^s5,GET_U64<bswap>(v,88)^s[0]);
+                v+=96;len-=96;
+            } while(len>256);
+            s0^=s4;s1^=s5;
+        }
+        do {
+            s0=fold(GET_U64<bswap>(v,0)^s0,GET_U64<bswap>(v,32)^s[0]);
+            s1=fold(GET_U64<bswap>(v,8)^s1,GET_U64<bswap>(v,40)^s[0]);
+            s2=fold(GET_U64<bswap>(v,16)^s2,GET_U64<bswap>(v,48)^s[0]);
+            s3=fold(GET_U64<bswap>(v,24)^s3,GET_U64<bswap>(v,56)^s[0]);
+            v+=64;len-=64;
+        } while(len>128);
+        s0^=s2;s1^=s3;
+    }
+    s0=fold(GET_U64<bswap>(v,0)^s0,GET_U64<bswap>(v,len-16)^s[0]);
+    s1=fold(GET_U64<bswap>(v,8)^s1,GET_U64<bswap>(v,len-8)^s[0]);
+    if(len>=32) {
+        s0=fold(GET_U64<bswap>(v,16)^s0,GET_U64<bswap>(v,len-32)^s[0]);
+        s1=fold(GET_U64<bswap>(v,24)^s1,GET_U64<bswap>(v,len-24)^s[0]);
+        if(len>=64) {
+            s0=fold(GET_U64<bswap>(v,32)^s0,GET_U64<bswap>(v,len-48)^s[0]);
+            s1=fold(GET_U64<bswap>(v,40)^s1,GET_U64<bswap>(v,len-40)^s[0]);
+            if(len>=96) {
+                s0=fold(GET_U64<bswap>(v,48)^s0,GET_U64<bswap>(v,len-64)^s[0]);
+                s1=fold(GET_U64<bswap>(v,56)^s1,GET_U64<bswap>(v,len-56)^s[0]);
+            }
+        }
+    }
+    return s0^s1;
+}
+template<bool bswap> static inline uint64_t hash_bytes(const uint8_t *p,size_t len,const FoldSeed &seed) {
+    uint64_t a=ror(seed.per,len),b=seed.s[1];
+    if(len>16)return hash_long<bswap>(p,len,a,seed.s);
+    if(len>=8) {a^=GET_U64<bswap>(p,0);b^=GET_U64<bswap>(p,len-8);}
+    else if(len>=4) {a^=GET_U32<bswap>(p,0);b^=GET_U32<bswap>(p,len-4);}
+    else if(len>0) {a^=p[0];b^=(uint64_t(p[len-1])<<8)|p[len/2];}
+    return fold(a,b);
+}
+template<bool bswap,bool quality> static void foldhash(const void *in,size_t len,seed_t seed,void *out) {
+    const FoldSeed &s=*(const FoldSeed *)(uintptr_t)seed;
+    uint64_t h=hash_bytes<bswap>((const uint8_t *)in,len,s);
+    if(quality)h=fold(h,UINT64_C(0x243f6a8885a308d3));
+    PUT_U64<bswap>(h,(uint8_t *)out,0);
+}
+}
+#if !defined(FOLDHASH_STANDALONE) && !defined(FOLDHASH_VECTOR_TEST)
+REGISTER_FAMILY(foldhash, $.src_url="https://github.com/orlp/foldhash", $.src_status=HashFamilyInfo::SRC_STABLEISH);
+REGISTER_HASH(foldhash_fast,
+    $.desc="foldhash 0.2.0 fast (Rust byte-slice write path)",
+    $.hash_flags=FLAG_HASH_XL_SEED,
+    $.impl_flags=FLAG_IMPL_MULTIPLY_64_128 | FLAG_IMPL_ROTATE | FLAG_IMPL_ROTATE_VARIABLE | FLAG_IMPL_LICENSE_ZLIB,
+    $.bits=64, $.verification_LE=0xA167BA5E, $.verification_BE=0x71AF646C,
+    $.hashfn_native=foldhash<false,false>, $.hashfn_bswap=foldhash<true,false>, $.seedfn=init_state);
+REGISTER_HASH(foldhash_quality,
+    $.desc="foldhash 0.2.0 quality (Rust byte-slice write path)",
+    $.hash_flags=FLAG_HASH_XL_SEED,
+    $.impl_flags=FLAG_IMPL_MULTIPLY_64_128 | FLAG_IMPL_ROTATE | FLAG_IMPL_ROTATE_VARIABLE | FLAG_IMPL_LICENSE_ZLIB,
+    $.bits=64, $.verification_LE=0xE269316E, $.verification_BE=0xE43F6B30,
+    $.hashfn_native=foldhash<false,true>, $.hashfn_bswap=foldhash<true,true>, $.seedfn=init_state);
+#else
+#include <iostream>
+#include <iomanip>
+#include <vector>
+#include <string>
+int main() {
+    uint64_t per,x;size_t n;int pattern;std::string mode;
+    while(std::cin>>std::hex>>per>>x>>std::dec>>pattern>>n>>mode) {
+        auto s=expand(per,x);std::vector<uint8_t> p(n);
+        for(size_t i=0;i<n;++i)p[i]=pattern==0?((i*131+(i>>3)*17+29)&255):pattern==1?0:'a'+i%26;
+        uint64_t h=hash_bytes<false>(p.data(),n,s);
+        if(mode=="vec_hash")h=fold(h^n,s.s[0]);
+        if(mode=="string_hash")h=fold(h^255,s.s[0]);
+        std::cout<<std::hex<<std::setfill('0')<<std::setw(16)<<h<<" "<<std::setw(16)<<fold(h,UINT64_C(0x243f6a8885a308d3))<<"\n";
+    }
+}
+#endif
diff --git a/hashes/umash.cpp b/hashes/umash.cpp
index ec78cdc9..0677680a 100644
--- a/hashes/umash.cpp
+++ b/hashes/umash.cpp
@@ -1190,6 +1190,54 @@ static void UMASH_FP( const void * in, const size_t len, const seed_t seed, void
     PUT_U64<false>(hash.hash[1], (uint8_t *)out, 8);
 }
 
+#elif defined(__aarch64__)
+namespace upstream_umash {
+#include "vendor/umash/umash.h"
+}
+extern "C" uint64_t smh_bswap_umash_full(const upstream_umash::umash_params *, uint64_t, int, const void *, size_t);
+extern "C" upstream_umash::umash_fp smh_bswap_umash_fprint(const upstream_umash::umash_params *, uint64_t, const void *, size_t);
+
+// The original wrapper appends base_seed after the upstream key material.
+struct smh_umash_params {
+    upstream_umash::umash_params key;
+    uint64_t base_seed;
+};
+static thread_local smh_umash_params umash_params_local;
+static smh_umash_params umash_params_global;
+
+static uintptr_t umash_slow_reseed(const seed_t seed) {
+    upstream_umash::umash_params_derive(&umash_params_local.key, seed, NULL);
+    umash_params_local.base_seed = seed;
+    return (uintptr_t)&umash_params_local;
+}
+
+static bool umash_init(void) {
+    upstream_umash::umash_params_derive(&umash_params_global.key, 0, NULL);
+    umash_slow_reseed(0);
+    return true;
+}
+
+template <bool reseed, bool bswap>
+static void UMASH(const void *in, const size_t len, const seed_t seed, void *out) {
+    const smh_umash_params *params = reseed ?
+        (const smh_umash_params *)(uintptr_t)seed : &umash_params_global;
+    const uint64_t hseed = reseed ? params->base_seed : (uint64_t)seed;
+    uint64_t h = bswap ? smh_bswap_umash_full(&params->key, hseed, 0, in, len)
+                       : upstream_umash::umash_full(&params->key, hseed, 0, in, len);
+    PUT_U64<false>(h, (uint8_t *)out, 0);
+}
+
+template <bool reseed, bool bswap>
+static void UMASH_FP(const void *in, const size_t len, const seed_t seed, void *out) {
+    const smh_umash_params *params = reseed ?
+        (const smh_umash_params *)(uintptr_t)seed : &umash_params_global;
+    const uint64_t hseed = reseed ? params->base_seed : (uint64_t)seed;
+    upstream_umash::umash_fp h = bswap ? smh_bswap_umash_fprint(&params->key, hseed, in, len)
+        : upstream_umash::umash_fprint(&params->key, hseed, in, len);
+    PUT_U64<false>(h.hash[0], (uint8_t *)out, 0);
+    PUT_U64<false>(h.hash[1], (uint8_t *)out, 8);
+}
+
 #endif
 //------------------------------------------------------------
 REGISTER_FAMILY(umash,
@@ -1197,7 +1245,7 @@ REGISTER_FAMILY(umash,
    $.src_status = HashFamilyInfo::SRC_ACTIVE
  );
 
-#if defined(HAVE_X86_64_CLMUL)
+#if defined(HAVE_X86_64_CLMUL) || defined(__aarch64__)
 
 REGISTER_HASH(UMASH_64,
    $.desc       = "UMASH-64 (which == 0)",
