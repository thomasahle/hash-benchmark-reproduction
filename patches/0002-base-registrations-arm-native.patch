+static inline v128
+v128_clmul_cross(v128 x)
+{
+	v128 swapped = vextq_u64(x, x, 1);
+#if UMASH_INLINE_ASM
+	/* Keep the result out of GPRs. */
+	__asm__("" : "+w"(swapped));
+#endif
+
+	return v128_clmul(vgetq_lane_u64(x, 0), vgetq_lane_u64(swapped, 0));
