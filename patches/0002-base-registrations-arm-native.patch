+    o0 = r ^ add0;
+    o1 = r ^ add1;
+}
+
+static FORCE_INLINE chainhash_gf chainhash_gf_reduce2_add( chainhash_v128 ab1, chainhash_v128 ab2, chainhash_gf add ) {
+    return chainhash_reduce_serial(chainhash_v_xor(ab1, ab2)) ^ add;
