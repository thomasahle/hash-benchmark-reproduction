diff --git a/CMakeLists.txt b/CMakeLists.txt
index 55816967..1320078c 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -201,6 +201,20 @@ add_library(
 )
 target_include_directories(SMHasher3Hashlib PRIVATE include/hashlib PUBLIC include/common)
 
+# ARM-only upstream C implementations. Existing x86 compilation is unchanged.
+if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(arm64|aarch64|ARM64)$")
+  set(ARM_HASH_C_SOURCES
+    hashes/vendor/umash/umash_impl.c
+    hashes/vendor/umash/umash_bswap.c
+    hashes/vendor/clhash/clhash.c
+    hashes/vendor/clhash/clhash_bswap.c)
+  target_sources(SMHasher3Hashlib PRIVATE ${ARM_HASH_C_SOURCES})
+  # PMULL is mandatory for these implementations; apply only to their C files.
+  set_source_files_properties(${ARM_HASH_C_SOURCES} PROPERTIES
+    COMPILE_FLAGS "-O3 -std=c11 -march=armv8-a+crypto")
+endif()
+
+
 # Hashinfo.cpp has special dispensation to access util/ for VCode.h.
 # Different CMake versions do this different ways
 if(${CMAKE_VERSION} VERSION_LESS "3.11.0")
@@ -346,3 +360,15 @@ add_custom_target(
   DEPENDS ${SRCS}
   WORKING_DIRECTORY ${CMAKE_SOURCE_DIR})
 endif()
+
+find_package(OpenSSL 3 REQUIRED COMPONENTS Crypto)
+target_link_libraries(SMHasher3Hashlib PUBLIC OpenSSL::Crypto)
+
+# The shipped HalftimeHash headers require C++17. Keep other objects C++11.
+set_source_files_properties(hashes/halftimefixed.cpp hashes/halftimeshipped.cpp
+  hashes/newhashes.cpp hashes/museair_v2.cpp PROPERTIES COMPILE_FLAGS "-std=c++17")
+set_property(SOURCE hashes/halftimeshipped.cpp APPEND_STRING PROPERTY COMPILE_FLAGS " -fwrapv")
+if(APPLE)
+  set_property(SOURCE hashes/halftimefixed.cpp hashes/halftimeshipped.cpp
+    APPEND_STRING PROPERTY COMPILE_FLAGS " -flax-vector-conversions")
+endif()
