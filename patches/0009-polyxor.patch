+# PolyXOR128: the polyxor crate (pinned in hashes/polyxor_ffi/Cargo.lock, Rust
+# toolchain pinned in rust-toolchain.toml) behind a C ABI shim, built as a
+# release/LTO staticlib with -C target-cpu=native and linked into the hash
+# library. The probe prints the crate's selected backend into the build log.
+set(CARGO_HINTS $ENV{HOME}/.cargo/bin)
+if(DEFINED ENV{CARGO_HOME})
+  list(PREPEND CARGO_HINTS $ENV{CARGO_HOME}/bin)
+endif()
+find_program(CARGO cargo HINTS ${CARGO_HINTS})
+if(NOT CARGO)
+  message(FATAL_ERROR "PolyXOR128 needs cargo (install Rust with rustup)")
+endif()
+find_package(Threads REQUIRED)
+set(POLYXOR_DIR ${CMAKE_SOURCE_DIR}/hashes/polyxor_ffi)
+set(POLYXOR_TARGET_DIR ${CMAKE_BINARY_DIR}/polyxor-cargo)
+set(POLYXOR_LIB ${POLYXOR_TARGET_DIR}/release/${CMAKE_STATIC_LIBRARY_PREFIX}polyxor_ffi${CMAKE_STATIC_LIBRARY_SUFFIX})
+add_custom_command(OUTPUT ${POLYXOR_LIB}
+  COMMAND ${CMAKE_COMMAND} -E env "RUSTFLAGS=-C target-cpu=native" CARGO_TARGET_DIR=${POLYXOR_TARGET_DIR}
+    ${CARGO} build --release --locked --manifest-path ${POLYXOR_DIR}/Cargo.toml
+  DEPENDS ${POLYXOR_DIR}/src/lib.rs ${POLYXOR_DIR}/Cargo.toml ${POLYXOR_DIR}/Cargo.lock ${POLYXOR_DIR}/rust-toolchain.toml
+  WORKING_DIRECTORY ${POLYXOR_DIR}
