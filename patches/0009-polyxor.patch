+target_link_libraries(SMHasher3Hashlib PUBLIC ${POLYXOR_LIB} Threads::Threads ${CMAKE_DL_LIBS})
+add_executable(polyxor_probe hashes/polyxor_ffi/probe.c)
+add_dependencies(polyxor_probe polyxor_ffi)
+target_link_libraries(polyxor_probe ${POLYXOR_LIB} Threads::Threads ${CMAKE_DL_LIBS})
+add_dependencies(SMHasher3 polyxor_probe)
+add_custom_command(TARGET SMHasher3 POST_BUILD COMMAND polyxor_probe VERBATIM)
